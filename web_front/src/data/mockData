/* ======================================================
   Attendance — last 180 days including today

   Every date is an attendance day in this demo.
====================================================== */

export const initialAttendanceRecords = Array.from(
  { length: 180 },
  (_, dayIndex) => {
    const date = addDays(today, dayIndex - 179);

    return initialStudents.map((child, childIndex) => ({
      id: `${date}-${child.id}`,
      date,
      childId: child.id,
      status:
        date === today
          ? child.attendanceStatus
          : (dayIndex + childIndex * 2) % 7 === 0
            ? 'Absent'
            : 'Present',
    }));
  }
).flat();

