export const dailyAttendance = Array.from(
  { length: 7 },
  (_, index) => {
    const date = addDays(today, index - 6);

    return {
      day: date.slice(5),
      count: initialAttendanceRecords.filter(
        (record) =>
          record.date === date &&
          record.status === 'Present'
      ).length,
    };
  }
);

export const monthlyAttendance = [
  ...new Set(
    initialAttendanceRecords.map(
      (record) => record.date.slice(0, 7)
    )
  ),
].map((month) => {
  const records = initialAttendanceRecords.filter(
    (record) => record.date.startsWith(month)
  );

  const recordedDays = new Set(
    records.map((record) => record.date)
  ).size;

  return {
    month,
    count: recordedDays
      ? Math.round(
          records.filter(
            (record) => record.status === 'Present'
          ).length / recordedDays
        )
      : 0,
  };
});

